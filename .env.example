# Separate Discovery Supabase project; never commit real keys.
DISCOVERY_SUPABASE_URL=
DISCOVERY_SUPABASE_SERVICE_ROLE_KEY=
# Random shared secret, provided only to authenticated KhanHomes publishing backend.
KHANHOMES_DISCOVERY_WEBHOOK_SECRET=
# Comma separated, publicly approved HTTPS media hosts. Never point at private storage.
DISCOVERY_ALLOWED_MEDIA_HOSTS=
# Optional public link back to existing operations workspace.
NEXT_PUBLIC_KHANHOMES_URL=https://khanhomes.vercel.app

# Discover accounts are SEPARATE from KhanHomes operations.
# Public values only. Keep disabled until verified auth, email and authorization.
NEXT_PUBLIC_DISCOVER_SUPABASE_URL=
NEXT_PUBLIC_DISCOVER_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_DISCOVER_ACCOUNTS_ENABLED=false
NEXT_PUBLIC_DISCOVER_REQUESTS_ENABLED=false
DISCOVER_ENABLE_PRIVATE_REQUESTS=false
